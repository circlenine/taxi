/**
 * マニュアルのスプシを、まるごと作り直す。
 * 戻り値は、結果らんに出す文。
 */
function mnBuild_() {
  const ss = mnBook_();
  const tabs = [
    ["目次", mnTocRows_()],
    ["合図", mnSignRows_()],
    ["満杯", mnFullRows_()],
    ["読取", mnReadRows_()],
    ["予定", mnPlanRows_()],
    ["困り", mnHelpRows_()]
  ];
  tabs.forEach(function (x) {
    if (typeof updBeat_ === "function") updBeat_("マニュアル " + x[0]);
    mnWriteTab_(ss, x[0], x[1]);
  });

  /*
   * ★タブの並びを、目次のとおりにそろえます。
   *   作った順に並ぶとは限らず、ばらばらだと探せません。
   */
  tabs.forEach(function (x, i) {
    try {
      const sh = ss.getSheetByName(x[0]);
      if (sh) { ss.setActiveSheet(sh); ss.moveActiveSheet(i + 1); }
    } catch (e) {}
  });

  // はじめに作られる「シート1」は、空のままなので落とす
  try {
    ["シート1", "Sheet1"].forEach(function (n) {
      const sh = ss.getSheetByName(n);
      if (sh && ss.getSheets().length > 1) ss.deleteSheet(sh);
    });
  } catch (e) {}

  try { ss.setActiveSheet(ss.getSheetByName("目次")); } catch (e) {}
  return ss;
}

/** [16] マニュアルを作り直す（そうさボタンから） */
function panelManual() {
  let ss;
  try { ss = mnBuild_(); }
  catch (e) { return "❌ 作れませんでした\n" + ((e && e.message) || e); }

  const url = ss.getUrl();
  // ★URLはLINEにも送ります。スマホでは、そのまま押せるほうが早いためです
  try {
    const me = (typeof updMe_ === "function") ? updMe_() : "";
    if (me && typeof lrPush_ === "function") {
      lrPush_(me, [{ type: "text", text:
        "📘 マニュアルを作り直しました\n" +
        "・タブ：目次／合図／満杯／読取／予定／困り\n" +
        "\n" + url }]);
    }
  } catch (e) {}

  return "作り直しました\n" +
         "・タブ：目次／合図／満杯／読取／予定／困り\n" +
         "・LINEにもURLを送りました\n" +
         "\n" + url;
}

/**
 * 「📘」… マニュアルのURLをLINEに返す（まーくさんだけ）。扱ったら true。
 *
 * ★作り直しはしません。開くだけです。
 *   読みたいだけのときに、毎回 作り直すのは時間のむだですし、
 *   自分で開いていたタブが目次に戻ってしまいます。
 */
function mnHandleCmd_(ev) {
  const t = String((ev && ev.message && ev.message.text) || "").trim()
    .replace(/[\s　️]/g, "");
  if (!/^(📘|📖|マニュアル|まにゅある|説明書|手順)$/.test(t)) return false;
  const uid = (ev && ev.source && ev.source.userId) || "";
  const me = (typeof updMe_ === "function") ? updMe_() : "";
  if (!me || uid !== me) return false;
  const reply = (ev && ev.replyToken) || "";

  /*
   * ★ここでは、無ければ作りません。
   *   読みたいだけのときに作りにいくと、時間がかかるうえ、
   *   返事（reply）の30秒に間に合わず、黙って終わることがあります。
   */
  let url = "";
  try {
    const id = PropertiesService.getScriptProperties().getProperty(MN_SS_KEY) || "";
    if (id) url = SpreadsheetApp.openById(id).getUrl();
  } catch (e) { url = ""; }
  if (typeof lineReply_ === "function") {
    lineReply_(reply, url
      ? "📘 マニュアル\n" +
        "・タブ：目次／合図／満杯／読取／予定／困り\n" +
        "\n" + url
      : "📘 まだ作っていません\n" +
        "記録用スプシの「説明」タブ →\n" +
        "[16] マニュアルを作り直す を押してください");
  }
  return true;
}
