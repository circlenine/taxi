/** このファイルのバージョン（先頭の ★★★ と必ずそろえる） */
const MN_VERSION = "M011ver";

/** マニュアルのスプシを覚えておく名札と、その題 */
const MN_SS_KEY = "MN_MANUAL_SS";
const MN_SS_NAME = "📘 タクシー記録システム マニュアル";

/** 見た目の決まり（スマホで読むための幅と色） */
const MN_COL_A = 46;        // 左のらん（番号・しるし）。細くする
const MN_COL_B = 560;       // 本文のらん。ここだけ広くとる
const MN_C_H1  = "#1a73e8"; // 大見出しの背景（濃い青）
const MN_C_H2  = "#e8f0fe"; // 中見出しの背景（薄い青）
const MN_C_WARN= "#fce8e6"; // 気をつけるところ（薄い赤）
const MN_C_OK  = "#e6f4ea"; // うまくいったとき（薄い緑）
const MN_C_STEP= "#fff8e1"; // 手順の番号（薄い黄）

/**
 * マニュアルのスプシを開く。無ければ作る。
 *
 * ★記録用スプシの中には作りません。
 *   記録用スプシはタブが多く、これ以上増やすと
 *   目当てのタブを探せなくなるためです（決まりごと）。
 */
function mnBook_() {
  const pr = PropertiesService.getScriptProperties();
  const id = pr.getProperty(MN_SS_KEY) || "";
  if (id) {
    try { return SpreadsheetApp.openById(id); }
    catch (e) { /* 消された・開けない。下で作り直す */ }
  }
  const ss = SpreadsheetApp.create(MN_SS_NAME);
  pr.setProperty(MN_SS_KEY, ss.getId());
  return ss;
}

/* ================================================================
 *  タブの引っ越し（まーくさんしか触らないタブを、こちらへ移す）
 *
 *  ★まーくさんのご指示です。
 *    記録用スプシはタブが多く、スマホではタブの行がすぐ埋まります。
 *    みんなが使うタブだけを残して、
 *    まーくさんしか触らないタブは こちらへ移します。
 *
 *  ★移すのは、この2つです。
 *      設定　　　　　… 決まりごとの値。人が読み書きするのは まーくさんだけ
 *      地図 … 乗り場のマップのリンク。貼るのも まーくさんだけ
 *
 *  ★「🗓️イベント台帳」は、もともと別のスプシに出しています。
 *    「天気」は、レポートの材料なので記録用スプシに残します。
 *
 *  ★いちばん大事なところ
 *    移したあとも、移す前と同じように動かないといけません。
 *    だから、読むときは かならず この順で探します。
 *      ① マニュアルのスプシ
 *      ② 記録用スプシ（移す前は、こちらにあります）
 *    こうしておけば、移す前でも、移したあとでも、途中でも動きます。
 * ================================================================ */

/** こちらへ移してよいタブ（名前は、それぞれのファイルの決まりに合わせる） */
/*
 * ★タブの名前は「絵文字なし・全角2文字以内」です（まーくさんの決まり）。
 *   前は「🗺️乗り場マップ」と書いていました。
 *   決まりを作っていただいたのに、こちらが直していませんでした。
 *   まーくさんが手で「地図」に変えてくださっていたので、
 *   このままでは [18] が地図タブを見つけられませんでした。
 */
const MN_MOVABLE = ["設定", "地図"];
/** 前の名前。まだ変えていないスプシでも、見つけられるように残す */
const MN_MOVABLE_OLD = { "地図": ["🗺️乗り場マップ", "乗り場マップ", "マップ"] };

/**
 * タブを探す。マニュアルのスプシが先、記録用スプシが後。
 *
 * ★マニュアルのスプシをまだ作っていなくても、落ちません。
 *   そのときは、これまでどおり記録用スプシを見ます。
 */
function mnFindSheet_(name, alsoLike) {
  const look = function (ss) {
    if (!ss) return null;
    try {
      const exact = ss.getSheetByName(name);
      if (exact) return exact;
      if (alsoLike && alsoLike.length) {
        const hit = ss.getSheets().filter(function (sh) {
          const n = String(sh.getName() || "");
          for (let i = 0; i < alsoLike.length; i++) {
            if (n.indexOf(alsoLike[i]) !== -1) return true;
          }
          return false;
        });
        if (hit.length) return hit[0];
      }
    } catch (e) {}
    return null;
  };

  // ① マニュアルのスプシ（作っていなければ、ここでは作らない）
  try {
    const id = PropertiesService.getScriptProperties().getProperty(MN_SS_KEY) || "";
    if (id) {
      const got = look(SpreadsheetApp.openById(id));
      if (got) return got;
    }
  } catch (e) {}

  // ② 記録用スプシ
  try { return look(mainSS_()); } catch (e) {}
  return null;
}

/**
 * [18] 設定・地図のタブを、マニュアルのスプシへ移す。
 *
 * ★取り返しがつかないので、かならず2回に分けます。
 *   1回目は、何を移すか見せるだけ。2回目で移します。
 *
 * ★写してから消します。写せなかったものは、消しません。
 *   「消えたのに、向こうにも無い」がいちばん困るためです。
 */
function panelMoveTabs() {
  const pr = PropertiesService.getScriptProperties();
  const okAt = Number(pr.getProperty("MN_MOVE_ASK") || 0);
  const fresh = okAt && (Date.now() - okAt) < 3 * 60000;

  let ss, book;
  try {
    ss = mainSS_();
    book = mnBook_();
  } catch (e) { return "❌ 開けませんでした\n" + ((e && e.message) || e); }

  const todo = [], already = [];
  MN_MOVABLE.forEach(function (n) {
    if (book.getSheetByName(n)) { already.push(n); return; }
    if (ss.getSheetByName(n)) { todo.push(n); return; }
    /*
     * ★前の名前のままのこともあります（「🗺️乗り場マップ」など）。
     *   そのときは、その名前のタブを移します。
     *   名前を変えていないだけで、中身は同じものだからです。
     */
    const olds = MN_MOVABLE_OLD[n] || [];
    for (let i = 0; i < olds.length; i++) {
      if (book.getSheetByName(olds[i])) { already.push(olds[i]); return; }
      if (ss.getSheetByName(olds[i])) { todo.push(olds[i]); return; }
    }
  });

  if (!todo.length) {
    pr.deleteProperty("MN_MOVE_ASK");
    return "移すものがありません\n" +
           (already.length ? "・もう移してあります：" + already.join("／") + "\n" : "") +
           "・記録用スプシに、その名前のタブがありません";
  }

  if (!fresh) {
    pr.setProperty("MN_MOVE_ASK", String(Date.now()));
    return "まだ何もしていません\n" +
           "・移すタブ：" + todo.join("／") + "\n" +
           (already.length ? "・もう移してある：" + already.join("／") + "\n" : "") +
           "・移したあとも、これまでどおり動きます\n" +
           "　（読むときは、両方を探しています）\n" +
           "\n" +
           "やるなら、3分以内にもう一度チェックしてください";
  }

  pr.deleteProperty("MN_MOVE_ASK");
  const done = [], ng = [];
  todo.forEach(function (n) {
    try {
      const src = ss.getSheetByName(n);
      if (!src) { ng.push(n + "（見つかりません）"); return; }
      // ★まず写します。写せてから、はじめて消します
      const cp = src.copyTo(book);
      cp.setName(n);
      if (!book.getSheetByName(n)) { ng.push(n + "（写せませんでした）"); return; }
      ss.deleteSheet(src);
      done.push(n);
    } catch (e) { ng.push(n + "（" + ((e && e.message) || e) + "）"); }
  });

  return "移しました\n" +
         "・移した：" + (done.join("／") || "なし") + "\n" +
         (ng.length ? "・できなかった：" + ng.join("／") + "\n" : "") +
         "・記録用スプシからは、消えています\n" +
         "\n" + book.getUrl();
}

/* ================================================================
 *  中身の書き方
 *
 *  1行を { k: 種類, a: 左, b: 本文 } で表します。
 *    h1   … 大見出し（濃い青）
 *    h2   … 中見出し（薄い青）
 *    s    … 手順（左に番号）
 *    t    … ふつうの文
 *    w    … 気をつけるところ（薄い赤）
 *    o    … うまくいったとき（薄い緑）
 *    q    … 画面に出る文（等幅・灰色）
 *    sp   … 空け行
 * ================================================================ */

function mnH1(b) { return { k: "h1", a: "", b: b }; }
function mnH2(b) { return { k: "h2", a: "", b: b }; }
function mnS(n, b) { return { k: "s", a: String(n), b: b }; }
function mnT(b) { return { k: "t", a: "", b: b }; }
function mnW(b) { return { k: "w", a: "!", b: b }; }
function mnO(b) { return { k: "o", a: "OK", b: b }; }
function mnQ(b) { return { k: "q", a: "", b: b }; }
function mnSp() { return { k: "sp", a: "", b: "" }; }

/**
 * 1つのタブを書く。
 *
 * ★毎回まるごと書き直します。
 *   書き足す形にすると、直したはずの古い説明が下に残り、
 *   どちらが正しいのか分からなくなるためです。
 */
function mnWriteTab_(ss, name, rows) {
  let sh = ss.getSheetByName(name);
  if (!sh) sh = ss.insertSheet(name);
  sh.clear();
  try { sh.clearNotes(); } catch (e) {}

  const vals = rows.map(function (r) { return [r.a, r.b]; });
  if (!vals.length) return sh;
  sh.getRange(1, 1, vals.length, 2).setValues(vals);

  sh.setColumnWidth(1, MN_COL_A);
  sh.setColumnWidth(2, MN_COL_B);
  const all = sh.getRange(1, 1, vals.length, 2);
  all.setWrap(true).setVerticalAlignment("top").setFontSize(11);

  rows.forEach(function (r, i) {
    const row = i + 1;
    const a = sh.getRange(row, 1), b = sh.getRange(row, 2);
    if (r.k === "h1") {
      sh.getRange(row, 1, 1, 2).merge()
        .setBackground(MN_C_H1).setFontColor("#ffffff")
        .setFontWeight("bold").setFontSize(14);
    } else if (r.k === "h2") {
      sh.getRange(row, 1, 1, 2).merge()
        .setBackground(MN_C_H2).setFontWeight("bold").setFontSize(12);
    } else if (r.k === "s") {
      a.setBackground(MN_C_STEP).setFontWeight("bold")
       .setHorizontalAlignment("center");
    } else if (r.k === "w") {
      sh.getRange(row, 1, 1, 2).setBackground(MN_C_WARN);
      a.setFontWeight("bold").setHorizontalAlignment("center");
    } else if (r.k === "o") {
      sh.getRange(row, 1, 1, 2).setBackground(MN_C_OK);
      a.setFontWeight("bold").setFontSize(9).setHorizontalAlignment("center");
    } else if (r.k === "q") {
      b.setFontFamily("Courier New").setFontColor("#5f6368").setFontSize(10);
    }
  });

  // ★高さは、中身に合わせて伸ばします。
  //   決め打ちにすると、長い行が途中で切れて読めません
  try { sh.autoResizeRows(1, vals.length); } catch (e) {}
  try { sh.setFrozenRows(0); } catch (e) {}
  try { sh.getRange(1, 3, vals.length, 1).clear(); } catch (e) {}
  return sh;
}

